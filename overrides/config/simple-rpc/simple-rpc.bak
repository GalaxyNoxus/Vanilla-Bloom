[general]
applicationID = "1526122255262945330"
enabled = true
debugging = false
launcherIntegration = false
rpcImageServer = false
rpcImageServerUrl = "https://rpcavatar.firstdark.dev"
version = 26

[init]
enabled = true
[[init.presence]]
type = "PLAYING"
description = "Loading the game..."
state = ""
largeImageKey = ["vanilla_bloom"]
largeImageText = "Vanilla Bloom"
smallImageKey = [""]
smallImageText = ""
buttons = [
    { label = "Download Modpack", url = "https://modrinth.com/modpack/vanillabloom" }
]

[main_menu]
enabled = true
[[main_menu.presence]]
type = "PLAYING"
description = "Browsing the menu"
state = ""
largeImageKey = ["vanilla_bloom"]
largeImageText = "Vanilla Bloom"
smallImageKey = ["{{images.player}}"]
smallImageText = "{{player.name}}"
buttons = [
    { label = "Download Modpack", url = "https://modrinth.com/modpack/vanillabloom" }
]

